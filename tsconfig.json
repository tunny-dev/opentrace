{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "examples/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages",
    "dist",
    "out"
  ]
}
