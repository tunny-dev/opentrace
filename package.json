{
  "name": "spurtrace-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter spurtrace-dashboard dev",
    "dev:all": "pnpm --parallel dev",
    "dev:docs": "pnpm --filter spurtrace-docs dev",
    "build": "pnpm --filter spurtrace-dashboard build && pnpm --filter spurtrace-docs build",
    "build:spurtrace": "pnpm --filter spurtrace build",
    "build:dashboard": "pnpm --filter spurtrace-dashboard build",
    "build:docs": "pnpm --filter spurtrace-docs build",
    "bundle:ui": "node scripts/build-dashboard-bundle.mjs",
    "package": "node scripts/build-dashboard-bundle.mjs && pnpm --filter spurtrace build",
    "demo": "pnpm --filter spurtrace build && node --experimental-strip-types examples/server.ts",
    "test:smoke": "pnpm --filter spurtrace build && node --experimental-strip-types examples/smoke-test.ts",
    "lint": "pnpm --filter spurtrace-dashboard lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "spurtrace": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "prettier": "^3.5.0",
    "typescript": "5.7.3"
  }
}
