# Auto detect text files and perform LF normalization across platforms
* text=auto eol=lf

# Source code files (Always LF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Dotfiles & Configs
.gitignore text eol=lf
.gitattributes text eol=lf
.prettierignore text eol=lf
.prettierrc text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Images (Binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.avif binary

# Fonts (Binary)
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Documents & Archives (Binary)
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.gz binary

# Database files (Binary)
*.sqlite binary
*.sqlite3 binary
*.sqlite-wal binary
*.sqlite-shm binary
*.db binary
